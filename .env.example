# Copy to .env and fill in. Real environment variables override this file.

# MusicBrainz asks every client to identify itself with contact info
# (an email address or a URL); it goes in the User-Agent header.
GT_CONTACT=

# Discogs personal access token: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=
# Last.fm API key: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Paths (workstation values; the Docker image forces /music and /data/...)
GT_LIBRARY=/mnt/viridian/media/Audio/Collection
GT_DB=state/library.db
GT_REPORTS=state/reports
# Genre dictionary: a MusicBee tag hierarchy file. Empty = the bundled
# RateYourMusic hierarchy; "off" = allow any genre.
GT_HIERARCHY=
# When tagging an inbox, the library's state DB, so spellings match it
# GT_VOCAB_DB=state/library.db

# Tuning
GT_TOP_N=6                 # max genres per artist (MusicBee's limit)
GT_MIN_SCORE=0.6           # minimum merged score for a genre to be kept
GT_LASTFM_MIN_COUNT=20     # Last.fm tag weight (0-100) below which tags are ignored
GT_WORKERS=2               # file I/O threads for apply/rollback (scan uses 4)
